sdk.dir=/path/to/android/sdk
# From Spotify Developer Dashboard → your app → Settings → Client ID
spotify.clientId=your_spotify_client_id_here

# From Unsplash Developers → your app → "Access Key" (NOT Secret Key).
# Used for the configurable background image feature. Free Demo tier: 50 req/hr.
unsplash.accessKey=your_unsplash_access_key_here

# Release signing — leave commented to fall back to debug-signed release builds.
# To configure, run: scripts/setup-signing.sh
#signing.keystoreFile=/absolute/path/to/release.keystore
#signing.keystorePassword=your_keystore_password
#signing.keyAlias=firetv
#signing.keyPassword=your_key_password
