<?xml version="1.0" encoding="utf-8"?>
<!-- One wallpaper in the picker grid: its thumbnail, its seed, and the size
     this screen would actually receive. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_wallpaper_card"
    android:padding="8dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true">

    <ImageView
        android:id="@+id/wallpaperThumb"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:scaleType="centerCrop"
        android:background="#0AFFFFFF"
        android:contentDescription="@string/wallpaper_picker_title" />

    <TextView
        android:id="@+id/wallpaperSeed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/wallpaperSize"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:maxLines="1" />
</LinearLayout>
