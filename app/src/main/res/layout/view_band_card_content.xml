<?xml version="1.0" encoding="utf-8"?>
<!--
    Internal content for `BandCard`. Inflated via merge into the BandCard
    LinearLayout itself, so the root here is <merge>. Card chrome (radius,
    border, left stripe) is painted by BandCard; this layout owns only the
    chip row + title + meta block.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="LinearLayout">

    <!-- Top row: tag chip + optional time + state chip. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/bandCardTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jetbrains_mono"
            android:includeFontPadding="false"
            android:letterSpacing="0.2"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textAllCaps="true"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/bandCardTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/jetbrains_mono"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:letterSpacing="0.14"
            android:textColor="#8CFFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/bandCardState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/jetbrains_mono"
            android:includeFontPadding="false"
            android:letterSpacing="0.2"
            android:textAllCaps="true"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Title — Manrope-500 20sp, single line ellipsed. -->
    <TextView
        android:id="@+id/bandCardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:fontFamily="@font/manrope"
        android:includeFontPadding="false"
        android:letterSpacing="-0.005"
        android:maxLines="1"
        android:textColor="@color/dock_text_pri"
        android:textSize="20sp" />

    <!-- Meta — single line, 14sp. -->
    <TextView
        android:id="@+id/bandCardMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:fontFamily="@font/manrope"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="#80FFFFFF"
        android:textSize="14sp" />
</merge>
