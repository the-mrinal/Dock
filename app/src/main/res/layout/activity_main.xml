<?xml version="1.0" encoding="utf-8"?>
<!--
    Phase 0 redesign: ArtWashView replaces the legacy ImageView background,
    BottomNavCapsuleView replaces the 4-dot text indicator. Pager content,
    streaming overlay, and onboarding pill behaviours are unchanged.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dock_bg"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:keepScreenOn="true">

    <!-- Full-bleed blurred art wash. Seed + intensity are driven per-page
         by MainActivity; sits behind everything else. -->
    <com.ambient.tvclock.ui.ArtWashView
        android:id="@id/artWashView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Legacy ImageView kept under the wash because BlurredBackgroundBinder
         still drives an alpha animation against it; once the per-page redesign
         lands the legacy binder will be retired and this view goes with it. -->
    <ImageView
        android:id="@+id/imageHomeBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="@dimen/tv_safe_horizontal"
        android:paddingTop="@dimen/tv_safe_top"
        android:paddingEnd="@dimen/tv_safe_horizontal"
        android:paddingBottom="@dimen/tv_safe_bottom">

        <FrameLayout
            android:id="@+id/contentDisplayGroup"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/onboardingPill"
            android:clipChildren="false"
            android:clipToPadding="false">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/dashboardPager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center" />
        </FrameLayout>

        <!-- First-launch onboarding pill (Decision #5). Hidden by default; MainActivity
             flips visibility when the receiver master toggle is off and the user is on
             the Home page within the 7-day onboarding window. -->
        <LinearLayout
            android:id="@+id/onboardingPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/pageIndicatorGroup"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_onboarding_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="6dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:text="@string/onboarding_mirroring_pill"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/onboardingDismiss"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/onboarding_dismiss"
                android:fontFamily="sans-serif-medium"
                android:focusable="true"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="×"
                android:textColor="@color/text_tertiary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Bottom nav capsule. Replaces the old 4-dot text indicator. The
             container keeps the `pageIndicatorGroup` id so MainActivity's
             ambient-mode alpha animations + side-by-side references in
             existing binders keep working with no churn. -->
        <FrameLayout
            android:id="@+id/pageIndicatorGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:clipChildren="false"
            android:clipToPadding="false">

            <com.ambient.tvclock.ui.BottomNavCapsuleView
                android:id="@id/bottomNavCapsule"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                app:activeDestination="1" />
        </FrameLayout>
    </RelativeLayout>

    <!-- Phase 3: mirroring overlay. Hidden until a sender connects. Sits above
         the dashboard so the SurfaceView covers the full screen edge-to-edge. -->
    <com.ambient.tvclock.receiver.ui.StreamingOverlay
        android:id="@+id/streamingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@android:color/black"
        android:visibility="gone" />
</FrameLayout>
