<?xml version="1.0" encoding="utf-8"?>
<!--
    Up Next queue row (Stream A). The Music NowPlaying view ships a single
    inline UpNextStrip card (`view_music_now_playing.xml`), but this item
    layout is kept and restyled for any RecyclerView that wants to render
    a Spotify queue entry in the same visual language.
-->
<com.ambient.tvclock.ui.FocusableContainer xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:accentColor="@color/dock_accent_chartreuse"
    app:focusRadius="14dp"
    app:proxyFocus="true">

    <FrameLayout
        android:id="@+id/queueRowRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dock_card"
        android:clickable="true"
        android:focusable="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="88dp"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="24dp"
            android:paddingBottom="16dp">

            <ImageView
                android:id="@+id/imageQueueArt"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textQueueTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/manrope"
                    android:maxLines="1"
                    android:textColor="@color/dock_text_pri"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/textQueueArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/manrope"
                    android:maxLines="1"
                    android:textColor="@color/dock_text_sec"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressQueueLoading"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="bottom"
            android:indeterminate="true"
            android:indeterminateTint="@color/dock_accent_chartreuse"
            android:visibility="gone" />
    </FrameLayout>
</com.ambient.tvclock.ui.FocusableContainer>
