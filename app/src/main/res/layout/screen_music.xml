<?xml version="1.0" encoding="utf-8"?>
<!--
    Music page (Stream A redesign, artboards 11–16).

    Stack:
      1. TopChrome row  — music tile + breadcrumb + LAN + clock + Browse pill.
      2. Sub-view frame — MusicScreenBinder swaps NowPlaying / Empty / Browse
         / PlaylistTracks here with a 150ms crossfade.

    The device picker (artboard 16) is hosted by SpotifyDevicePickerDialogFragment.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/musicScreenRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:descendantFocusability="afterDescendants"
    android:orientation="vertical">

    <!-- ── TopChrome ──────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/musicTopChrome"
        android:layout_width="match_parent"
        android:layout_height="@dimen/music_top_chrome_height"
        android:layout_marginBottom="@dimen/music_top_chrome_bottom"
        android:baselineAligned="false"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Music tile + "MUSIC" eyebrow. -->
        <FrameLayout
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_dock_card_small">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_music_note"
                android:tint="@color/dock_text_pri" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/manrope"
            android:letterSpacing="0.22"
            android:text="@string/music_eyebrow"
            android:textAllCaps="true"
            android:textColor="@color/dock_text_pri"
            android:textSize="14sp"
            android:textStyle="normal" />

        <!-- Breadcrumb separator + path (visible when in Browse / PlaylistTracks). -->
        <View
            android:id="@+id/topChromeBreadcrumbDivider"
            android:layout_width="1dp"
            android:layout_height="16dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="@color/dock_border_strong"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/topChromeBreadcrumb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/topChromeCrumb1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope"
                android:text="@string/music_breadcrumb_root"
                android:textColor="@color/dock_text_sec"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/topChromeCrumb2Chevron"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right"
                android:tint="@color/dock_text_sec" />

            <TextView
                android:id="@+id/topChromeCrumb2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope"
                android:text="@string/music_breadcrumb_browse"
                android:textColor="@color/dock_text_sec"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/topChromeCrumb3Chevron"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right"
                android:tint="@color/dock_text_sec"
                android:visibility="gone" />

            <TextView
                android:id="@+id/topChromeCrumb3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/manrope"
                android:maxLines="1"
                android:textColor="@color/dock_text_pri"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- LAN + Wi-Fi indicator (mono). -->
        <LinearLayout
            android:id="@+id/topChromeLan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_wifi"
                android:tint="@color/dock_text_ter" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/jetbrains_mono"
                android:text="@string/music_lan"
                android:textColor="@color/dock_text_ter"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Tabular clock. -->
        <TextView
            android:id="@+id/topChromeClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:fontFamily="@font/manrope"
            android:fontFeatureSettings="tnum"
            android:letterSpacing="0.04"
            android:textColor="@color/dock_text_pri"
            android:textSize="18sp" />

        <!-- "Browse Playlists" pill. -->
        <com.ambient.tvclock.ui.FocusableContainer
            android:id="@+id/topChromeBrowseFocus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:nextFocusDown="@id/heroButtonPlay"
            app:accentColor="@color/dock_accent_chartreuse"
            app:focusRadius="999dp"
            app:proxyFocus="true">

            <LinearLayout
                android:id="@+id/topChromeBrowsePill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dock_card_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/music_breadcrumb_browse"
                    android:textAppearance="@style/TextAppearance.Dock.Label.Large"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/dock_text_pri" />
            </LinearLayout>
        </com.ambient.tvclock.ui.FocusableContainer>
    </LinearLayout>

    <!-- ── Sub-view crossfade host ───────────────────────────────────── -->
    <FrameLayout
        android:id="@+id/musicSubviewFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false">

        <include
            android:id="@+id/musicViewNowPlaying"
            layout="@layout/view_music_now_playing"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            android:id="@+id/musicViewEmpty"
            layout="@layout/view_music_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <include
            android:id="@+id/musicViewBrowse"
            layout="@layout/view_music_browse"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <include
            android:id="@+id/musicViewPlaylistTracks"
            layout="@layout/view_music_playlist_tracks"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
