<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:descendantFocusability="afterDescendants"
    android:orientation="horizontal"
    android:paddingTop="8dp">

    <FrameLayout
        android:id="@+id/panelBrowse"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="20dp"
        android:layout_weight="0.56"
        android:paddingStart="4dp"
        android:paddingEnd="8dp">

    <LinearLayout
        android:id="@+id/viewDefaultPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/rowBrowseEntry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_track_row_focus"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:nextFocusRight="@+id/buttonPlayPause"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.02"
                android:text="@string/spotify_browse_playlists"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sectionUpNext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.04"
                android:text="@string/music_section_up_next"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textQueueHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/upNextContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_track_row_focus"
                android:clickable="true"
                android:focusable="true"
                android:nextFocusRight="@+id/buttonPlayPause"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="72dp"
                    android:orientation="horizontal"
                    android:paddingStart="6dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="8dp">

                    <ImageView
                        android:id="@+id/imageUpNextArt"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_album_frame"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textUpNextTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/textUpNextArtist"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif"
                            android:maxLines="1"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progressUpNextLoading"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_gravity="bottom"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/accent_spotify"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sectionRecent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="28dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textRecentSectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.04"
                android:text="@string/music_section_recent"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textRecentHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerRecentlyPlayed"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:clipToPadding="true"
                android:nestedScrollingEnabled="true"
                android:overScrollMode="never"
                android:paddingBottom="8dp"
                android:scrollbars="none" />
        </LinearLayout>
    </LinearLayout>

    <include
        android:id="@+id/viewBrowsePanel"
        layout="@layout/view_browse_playlists"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/panelNowPlaying"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.44"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/imageAlbumBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <View
            android:id="@+id/viewNowPlayingScrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_now_playing_scrim" />

        <LinearLayout
            android:id="@+id/nowPlayingContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="16dp"
            android:paddingEnd="18dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="14dp"
                android:layout_weight="1"
                android:clipChildren="true"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textNowPlayingBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08"
                    android:text="@string/now_playing_badge"
                    android:textAllCaps="true"
                    android:textColor="@color/text_tertiary"
                    android:textSize="10sp"
                    android:visibility="gone" />

                <FrameLayout
                    android:id="@+id/albumArtContainer"
                    android:layout_width="170dp"
                    android:layout_height="170dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/bg_album_frame"
                    android:elevation="6dp">

                    <ImageView
                        android:id="@+id/imageAlbumArt"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/cd_album_art"
                        android:padding="2dp"
                        android:scaleType="centerCrop" />

                    <ImageView
                        android:id="@+id/imageAlbumPlaceholder"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_music_placeholder"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/textTrackTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textTrackArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/textTrackAlbum"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="@color/text_tertiary"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sidebarNowPlayingBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_now_playing_pill"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp">

                <com.ambient.tvclock.PlaybackProgressBar
                    android:id="@+id/waveformPlayback"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/mediaControlsGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:clipChildren="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageButton
                        android:id="@+id/buttonSkipPrevious"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_control_icon"
                        android:clickable="true"
                        android:contentDescription="@string/cd_skip_previous"
                        android:focusable="true"
                        android:nextFocusLeft="@+id/upNextContent"
                        android:nextFocusRight="@+id/buttonPlayPause"
                        android:padding="10dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_skip_previous"
                        android:tint="@color/text_primary" />

                    <ImageButton
                        android:id="@+id/buttonPlayPause"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_play_button_spotify"
                        android:clickable="true"
                        android:contentDescription="@string/cd_play_pause"
                        android:focusable="true"
                        android:nextFocusLeft="@+id/buttonSkipPrevious"
                        android:nextFocusRight="@+id/buttonSkipNext"
                        android:nextFocusUp="@+id/upNextContent"
                        android:padding="16dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_pause"
                        android:tint="#000000" />

                    <ImageButton
                        android:id="@+id/buttonSkipNext"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_control_icon"
                        android:clickable="true"
                        android:contentDescription="@string/cd_skip_next"
                        android:focusable="true"
                        android:nextFocusLeft="@+id/buttonPlayPause"
                        android:nextFocusRight="@+id/buttonDeviceCast"
                        android:padding="10dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_skip_next"
                        android:tint="@color/text_primary" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageButton
                        android:id="@+id/buttonDeviceCast"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_cast_button"
                        android:clickable="true"
                        android:contentDescription="@string/cd_switch_device"
                        android:focusable="true"
                        android:nextFocusLeft="@+id/buttonSkipNext"
                        android:nextFocusUp="@+id/buttonPlayPause"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_cast"
                        android:tint="@color/accent_spotify" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/textMusicEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/music_empty_state"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
