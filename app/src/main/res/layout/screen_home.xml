<?xml version="1.0" encoding="utf-8"?>
<!--
    Dock Home — artboards 01 / 02 / 03 (active multi-now, active ending-soon,
    ambient idle). HeroClock at top, two widget cards below, ambient tickler
    capsule revealed once `setAmbient(true)` fires from MainActivity.

    Active and ambient sub-trees live in the same FrameLayout slot so the
    HeroClock can stay roughly centered as the surrounding content morphs.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/homeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Top "Dock · Studio" eyebrow. -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="36dp"
        android:fontFamily="@font/jetbrains_mono"
        android:includeFontPadding="false"
        android:letterSpacing="0.32"
        android:text="@string/dock_studio_eyebrow"
        android:textAllCaps="true"
        android:textColor="#52FFFFFF"
        android:textSize="12sp" />

    <!-- "Idle · any key wakes" caption, top-right. Visibility toggled in binder. -->
    <TextView
        android:id="@+id/textHomeIdleHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="64dp"
        android:alpha="0"
        android:fontFamily="@font/jetbrains_mono"
        android:includeFontPadding="false"
        android:letterSpacing="0.22"
        android:text="@string/home_ambient_idle"
        android:textAllCaps="true"
        android:textColor="#38FFFFFF"
        android:textSize="12sp" />

    <!-- Vertical clock + widgets stack. -->
    <LinearLayout
        android:id="@+id/homeStack"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingBottom="60dp">

        <!-- HeroClock: time + :seconds / AM-PM column + date subtitle. -->
        <LinearLayout
            android:id="@+id/homeHeroClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/homeClockGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:clipChildren="false"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textHomeClockTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/manrope"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.04"
                    android:text="11:14"
                    android:textColor="@color/dock_text_pri"
                    android:textSize="260sp" />

                <!-- :seconds + AM/PM, both right-aligned to the colon. -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginBottom="22dp"
                    android:gravity="start"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textHomeClockSeconds"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/manrope"
                        android:fontFeatureSettings="tnum"
                        android:includeFontPadding="false"
                        android:letterSpacing="-0.02"
                        android:text=":29"
                        android:textColor="#6BFFFFFF"
                        android:textSize="46sp" />

                    <TextView
                        android:id="@+id/textHomeClockAmPm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/jetbrains_mono"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.24"
                        android:text="PM"
                        android:textAllCaps="true"
                        android:textColor="#6BFFFFFF"
                        android:textSize="14sp"
                        android:textStyle="normal" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/textHomeClockDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/manrope"
                android:includeFontPadding="false"
                android:letterSpacing="0.01"
                android:text="Tuesday, May 19"
                android:textColor="#9EFFFFFF"
                android:textSize="30sp" />
        </LinearLayout>

        <!-- 56dp gap above the widget cluster. -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="56dp" />

        <!-- Active state: 2-column widget grid. -->
        <LinearLayout
            android:id="@+id/homeWidgetsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="64dp">

            <com.ambient.tvclock.ui.FocusableContainer
                xmlns:app="http://schemas.android.com/apk/res-auto"
                android:id="@+id/homeTodayFocus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:layout_weight="1"
                android:focusable="true"
                android:focusableInTouchMode="true"
                app:accentColor="@color/nav_accent_calendar"
                app:focusRadius="18dp">

                <include
                    android:id="@+id/homeWidgetToday"
                    layout="@layout/home_widget_today"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.ambient.tvclock.ui.FocusableContainer>

            <com.ambient.tvclock.ui.FocusableContainer
                xmlns:app="http://schemas.android.com/apk/res-auto"
                android:id="@+id/homeMusicFocus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:focusable="true"
                android:focusableInTouchMode="true"
                app:accentColor="@color/nav_accent_music"
                app:focusRadius="18dp">

                <include
                    android:id="@+id/homeWidgetMusic"
                    layout="@layout/home_widget_music"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.ambient.tvclock.ui.FocusableContainer>
        </LinearLayout>
    </LinearLayout>

    <!-- Ambient tickler. Lives in its own FrameLayout child so the active
         widget row can keep its space when ambient is off, and so the ambient
         capsule can sit at the vertical centre below the clock independent of
         the widget row's height when active. -->
    <FrameLayout
        android:id="@+id/homeAmbientFrame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingTop="640dp"
        android:visibility="invisible">

        <include
            layout="@layout/home_ambient_tickler"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|top" />
    </FrameLayout>
</FrameLayout>
