<?xml version="1.0" encoding="utf-8"?>
<!-- 56dp rounded square behind each device row icon (inactive state). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/dock_card" />
    <stroke
        android:width="1dp"
        android:color="@color/dock_border" />
    <corners android:radius="12dp" />
</shape>
