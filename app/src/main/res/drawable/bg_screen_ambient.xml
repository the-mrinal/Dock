<?xml version="1.0" encoding="utf-8"?>
<!-- Permanent ambient backdrop: a quiet sheen rising from the top-left so
     the dashboard never reads as flat black, echoing the album-art wash
     even when nothing is playing. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_screen" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.2"
                android:centerY="0.1"
                android:gradientRadius="1500dp"
                android:startColor="#3D46545C"
                android:centerColor="#14161B1E"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
