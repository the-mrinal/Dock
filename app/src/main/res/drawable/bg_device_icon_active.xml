<?xml version="1.0" encoding="utf-8"?>
<!-- 56dp tinted square behind each device row icon (active state).
     Mirrors the HTML's `${accent}1f` fill + `${accent}55` border. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#1FC8F25C" />
    <stroke
        android:width="1dp"
        android:color="#55C8F25C" />
    <corners android:radius="12dp" />
</shape>
