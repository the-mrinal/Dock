<?xml version="1.0" encoding="utf-8"?>
<!-- Primary transport button (round). Filled chartreuse only when focused so
     the focused state is unmistakable on a TV remote; otherwise a neutral
     elevated pill that doesn't compete with surrounding card backgrounds. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@color/dock_accent_chartreuse" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/dock_bg_elev" />
            <stroke
                android:width="1dp"
                android:color="@color/dock_border_strong" />
        </shape>
    </item>
</selector>
