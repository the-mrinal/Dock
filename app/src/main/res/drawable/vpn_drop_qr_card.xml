<?xml version="1.0" encoding="utf-8"?>
<!--
    White-padded QR card. 18dp radius, solid white fill, a 1dp translucent
    border, and a generous drop shadow (rendered via layer-list since we don't
    have a real shadow primitive in vector XML).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="0dp"
        android:left="0dp"
        android:right="0dp"
        android:top="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <stroke android:width="1dp" android:color="#0FFFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</layer-list>
