<?xml version="1.0" encoding="utf-8"?>
<!--
    Two-state rail item background.
    - Default: transparent + 2dp transparent left bar (keeps active/inactive at
      identical horizontal indent).
    - state_selected: dock_card_focus fill + 2dp white left bar.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/dock_card_focus" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item
                android:width="2dp"
                android:gravity="start">
                <shape android:shape="rectangle">
                    <solid android:color="@color/dock_text_pri" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item
                android:width="2dp"
                android:gravity="start">
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
