<?xml version="1.0" encoding="utf-8"?>
<!-- Larger dock card variant (18dp) used by Home widgets, matching the HTML
     reference where the wider 2-up widget cards sit at radius 18. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/dock_card" />
    <stroke
        android:width="1dp"
        android:color="@color/dock_border" />
    <corners android:radius="18dp" />
</shape>
