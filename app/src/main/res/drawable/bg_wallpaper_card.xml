<?xml version="1.0" encoding="utf-8"?>
<!-- Grid cell in the wallpaper picker. The focus ring has to read from across
     a room, so focused state is a solid bright border rather than a tint. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#1FFFFFFF" />
            <stroke android:width="3dp" android:color="@color/text_primary" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0DFFFFFF" />
            <stroke android:width="1dp" android:color="#1FFFFFFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
