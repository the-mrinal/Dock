<?xml version="1.0" encoding="utf-8"?>
<!-- Translucent "card" background used by Music sub-views.
     Mirrors the HTML `T.card` rgba(255,255,255,0.04) + 1dp `T.border`. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/dock_card" />
    <stroke
        android:width="1dp"
        android:color="@color/dock_border" />
    <corners android:radius="14dp" />
</shape>
