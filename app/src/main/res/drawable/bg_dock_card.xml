<?xml version="1.0" encoding="utf-8"?>
<!-- Translucent card scrim, matches HTML `T.card` (white 0A) + 1px border. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/dock_card" />
    <stroke
        android:width="1dp"
        android:color="@color/dock_border" />
    <corners android:radius="18dp" />
</shape>
